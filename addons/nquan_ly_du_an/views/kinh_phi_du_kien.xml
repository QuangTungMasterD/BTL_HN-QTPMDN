<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_kinh_phi_du_kien_form" model="ir.ui.view">
            <field name="name">kinh_phi_du_kien.form</field>
            <field name="model">kinh_phi_du_kien</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_read_only" style="font-size:25px">Kinh phí dự kiến</div>
                        <group col="4">
                            <field name="du_an_id"/>
                            <field name="hang_muc"/>
                            <field name="so_tien"/>
                        </group>
                        <group>
                            <field name="ghi_chu"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_kinh_phi_du_kien_tree" model="ir.ui.view">
            <field name="name">kinh_phi_du_kien.tree</field>
            <field name="model">kinh_phi_du_kien</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="du_an_id"/>
                    <field name="hang_muc"/>
                    <field name="so_tien"/>
                </tree>
            </field>
        </record>

        <record id="kinh_phi_du_kien_search" model="ir.ui.view">
            <field name="model">kinh_phi_du_kien</field>
            <field name="arch" type="xml">
                <search>
                    <field name="du_an_id"/>
                    <field name="hang_muc"/>
                </search>
            </field>
        </record>

        <record id="action_kinh_phi_du_kien" model="ir.actions.act_window">
            <field name="name">Kinh phí dự kiến</field>
            <field name="res_model">kinh_phi_du_kien</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="kinh_phi_du_kien_search"/>
        </record>
    </data>
</odoo>

