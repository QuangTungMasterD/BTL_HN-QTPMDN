<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bao_cao_tien_do_du_an_form" model="ir.ui.view">
            <field name="name">bao_cao_tien_do_du_an.form</field>
            <field name="model">bao_cao_tien_do_du_an</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1>Báo cáo tiến độ dự án</h1>
                        </div>
                        <group>
                            <group>
                                <field name="du_an_id" options="{'no_create': True}"/>
                                <field name="ngay_bao_cao"/>
                                <field name="nguoi_bao_cao_id" />
                            </group>
                            <group>
                                <field name="tien_do"/>
                            </group>
                        </group>
                        <group string="Nội dung">
                            <field name="noi_dung" nolabel="1" placeholder="Nhập nội dung báo cáo..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_bao_cao_tien_do_du_an_tree" model="ir.ui.view">
            <field name="name">bao_cao_tien_do_du_an.tree</field>
            <field name="model">bao_cao_tien_do_du_an</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="du_an_id"/>
                    <field name="ngay_bao_cao"/>
                    <field name="tien_do"/>
                    <field name="noi_dung"/>
                    <field name="nguoi_bao_cao_id" />
                </tree>
            </field>
        </record>

        <record id="view_bao_cao_tien_do_du_an_search" model="ir.ui.view">
            <field name="name">bao_cao_tien_do_du_an.search</field>
            <field name="model">bao_cao_tien_do_du_an</field>
            <field name="arch" type="xml">
                <search>
                    <field name="du_an_id"/>
                    <field name="ngay_bao_cao"/>
                    <field name="tien_do"/>
                    <field name="nguoi_bao_cao_id" />
                    <filter name="filter_high_progress" string="Tiến độ cao (>50%)" domain="[('tien_do','>',50)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_du_an" string="Dự án" context="{'group_by':'du_an_id'}"/>
                        <filter name="group_by_ngay" string="Ngày báo cáo" context="{'group_by':'ngay_bao_cao'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action window -->
        <record id="action_bao_cao_tien_do_du_an" model="ir.actions.act_window">
            <field name="name">Báo cáo tiến độ dự án</field>
            <field name="res_model">bao_cao_tien_do_du_an</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_bao_cao_tien_do_du_an_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo báo cáo tiến độ mới cho dự án
                </p>
            </field>
        </record>
    </data>
</odoo>