<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_du_an_form" model="ir.ui.view">
            <field name="name">du_an.form</field>
            <field name="model">du_an</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_read_only" style="font-size:25px">Dự án</div>
                        <group string="Thông tin chung" col="4">
                            <field name="ma_du_an"/>
                            <field name="name"/>
                            <field name="khach_hang_id"/>
                            <field name="phu_trach_id"/>
                            <field name="do_uu_tien"/>
                            <field name="trang_thai"/>
                            <field name="mo_ta"/>
                            <field name="ghi_chu"/>
                        </group>
                        <group string="Thời gian" col="4">
                            <field name="ngay_bd"/>
                            <field name="ngay_kt_du_kien"/>
                            <field name="ngay_kt_thuc_te"/>
                        </group>
                        <!-- <notebook>
                            <page string="Công việc">
                                <field name="cong_viec_ids">
                                    <tree editable="bottom">
                                        <field name="ma_cv"/>
                                        <field name="ten_cv"/>
                                        <field name="phu_trach_id"/>
                                        <field name="trang_thai"/>
                                        <field name="ngay_bd"/>
                                        <field name="ngay_kt_du_kien"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Kinh phí dự kiến">
                                <field name="kinh_phi_ids">
                                    <tree editable="bottom">
                                        <field name="hang_muc"/>
                                        <field name="so_tien"/>
                                        <field name="ghi_chu"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook> -->
                    </sheet>

                    <!-- <notebook>
                        <page string="Nhân viên tham gia">
                            <field name="nhan_vien_tham_gia_ids">
                                <tree editable="bottom">
                                    <field name="nhan_vien_id"/>
                                    <field name="vai_tro"/>
                                </tree>
                            </field>
                        </page>
                    </notebook> -->
                </form>
            </field>
        </record>

        <record id="view_du_an_tree" model="ir.ui.view">
            <field name="name">du_an.tree</field>
            <field name="model">du_an</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ma_du_an"/>
                    <field name="name"/>
                    <field name="khach_hang_id"/>
                    <field name="phu_trach_id"/>
                    <field name="trang_thai"/>
                    <field name="ngay_bd"/>
                    <field name="ngay_kt_du_kien"/>
                    <field name="ngay_kt_thuc_te"/>
                </tree>
            </field>
        </record>

        <record id="du_an_search" model="ir.ui.view">
            <field name="model">du_an</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ma_du_an"/>
                    <field name="name"/>
                    <field name="khach_hang_id"/>
                    <field name="phu_trach_id"/>
                    <field name="trang_thai"/>
                    <field name="ngay_bd"/>
                    <field name="ngay_kt_du_kien"/>
                    <field name="ngay_kt_thuc_te"/>
                </search>
            </field>
        </record>

        <record id="view_du_an_kanban" model="ir.ui.view">
            <field name="name">du_an.kanban</field>
            <field name="model">du_an</field>
            <field name="arch" type="xml">
                <kanban>
                    <!-- Các trường cần sử dụng trong template -->
                    <field name="ma_du_an"/>
                    <field name="name"/>
                    <field name="khach_hang_id"/>
                    <field name="phu_trach_id"/>
                    <field name="trang_thai"/>
                    <field name="tien_do_phan_tram"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="ma_du_an"/> - <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>Khách hàng: <field name="khach_hang_id"/></div>
                                    <div>Phụ trách: <field name="phu_trach_id"/></div>
                                    <div>Trạng thái: <field name="trang_thai"/></div>
                                    <div>Tiến độ: <field name="tien_do_phan_tram"/>%</div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_du_an" model="ir.actions.act_window">
            <field name="name">Dự án</field>
            <field name="res_model">du_an</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="du_an_search"/>
        </record>
    </data>
</odoo>
