<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Phòng ban (dùng hr.department) -->
    <record id="department_bgd" model="hr.department">
        <field name="name">Ban giám đốc</field>
    </record>
    <record id="department_kt" model="hr.department">
        <field name="name">Phòng Kỹ thuật</field>
    </record>
    <record id="department_kd" model="hr.department">
        <field name="name">Phòng Kinh doanh</field>
    </record>

    <!-- Chức vụ (dùng hr.job) -->
    <record id="job_gd" model="hr.job">
        <field name="name">Giám đốc</field>
    </record>
    <record id="job_tp" model="hr.job">
        <field name="name">Trưởng phòng</field>
    </record>
    <record id="job_nv" model="hr.job">
        <field name="name">Nhân viên</field>
    </record>

    <!-- Nhân viên (hr.employee mở rộng) -->
    <record id="employee_vinh" model="hr.employee">
        <field name="ma_dinh_danh">NV001</field>
        <field name="name">Nguyễn Văn Vinh</field>
        <field name="gender">male</field>
        <field name="birthday">1990-05-10</field>
        <field name="mobile_phone">0909123456</field>
        <field name="work_email">vinh.nv@example.com</field>
        <field name="que_quan">Hà Nội</field>
        <field name="ngay_vao_lam">2020-01-01</field>
        <field name="department_id" ref="department_bgd"/>
        <field name="job_id" ref="job_gd"/>
        <field name="trang_thai">dang_lam</field>
    </record>

    <record id="employee_phu" model="hr.employee">
        <field name="ma_dinh_danh">NV002</field>
        <field name="name">Trần Thị Phú</field>
        <field name="gender">female</field>
        <field name="birthday">1992-08-15</field>
        <field name="mobile_phone">0909988776</field>
        <field name="work_email">phu.tt@example.com</field>
        <field name="que_quan">Hải Phòng</field>
        <field name="ngay_vao_lam">2021-03-15</field>
        <field name="department_id" ref="department_kd"/>
        <field name="job_id" ref="job_tp"/>
        <field name="trang_thai">dang_lam</field>
    </record>

    <record id="employee_khanh" model="hr.employee">
        <field name="ma_dinh_danh">NV003</field>
        <field name="name">Lê Văn Khánh</field>
        <field name="gender">male</field>
        <field name="birthday">1995-12-20</field>
        <field name="mobile_phone">0909777888</field>
        <field name="work_email">khanh.lv@example.com</field>
        <field name="que_quan">Đà Nẵng</field>
        <field name="ngay_vao_lam">2022-06-01</field>
        <field name="department_id" ref="department_kt"/>
        <field name="job_id" ref="job_nv"/>
        <field name="trang_thai">dang_lam</field>
    </record>
</odoo>