<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Graph: Nhân viên theo đơn vị và giới tính -->
        <record id="view_nhan_vien_graph_don_vi" model="ir.ui.view">
            <field name="name">nhan_vien.graph.don_vi</field>
            <field name="model">nhan_vien</field>
            <field name="arch" type="xml">
                <graph type="bar">
                    <field name="don_vi_id" type="row"/>
                    <field name="gioi_tinh" type="col"/>
                    <field name="id" type="measure" operator="count"/>
                </graph>
            </field>
        </record>

        <!-- Graph: Nhân viên theo chức vụ -->
        <record id="view_nhan_vien_graph_chuc_vu" model="ir.ui.view">
            <field name="name">nhan_vien.graph.chuc_vu</field>
            <field name="model">nhan_vien</field>
            <field name="arch" type="xml">
                <graph type="bar">
                    <field name="chuc_vu_id" type="row"/>
                    <field name="id" type="measure" operator="count"/>
                </graph>
            </field>
        </record>

        <!-- Pivot: Nhân viên theo đơn vị và trạng thái -->
        <record id="view_nhan_vien_pivot" model="ir.ui.view">
            <field name="name">nhan_vien.pivot</field>
            <field name="model">nhan_vien</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="don_vi_id" type="row"/>
                    <field name="trang_thai" type="col"/>
                    <field name="id" type="measure" operator="count"/>
                </pivot>
            </field>
        </record>

        <!-- Action dashboard cho Nhân sự -->
        <record id="action_nhan_su_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboard Nhân sự</field>
            <field name="res_model">nhan_vien</field>
            <field name="view_mode">graph,pivot</field>
            <field name="view_id" ref="view_nhan_vien_graph_don_vi"/>   <!-- view mặc định là graph -->
            <field name="context">{'search_default_group_by_don_vi': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Thống kê nhân viên theo đơn vị, chức vụ,...
                </p>
            </field>
        </record>
    </data>
</odoo>