<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_task_deadline" model="mail.template">
            <field name="name">Nhắc công việc sắp hết hạn</field>
            <field name="model_id" ref="model_cong_viec"/>
            <field name="subject">🔔 Công việc {{ object.ten_cv }} sắp đến hạn</field>
            <field name="email_from">{{ user.email or '' }}</field>
            <field name="email_to">
                {{ ','.join(object.nhan_vien_phu_trach_ids.mapped('work_email')) }}
            </field>
            <field name="email_cc">
                {{ object.du_an_id.phu_trach_id.work_email or '' }}
            </field>
            <field name="reply_to">{{ user.email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                    <p>Kính gửi,</p>
                    
                    <p>Công việc <strong><t t-out="object.ten_cv or ''"/></strong> 
                    (mã: <t t-out="object.ma_cv or ''"/>) 
                    thuộc dự án <strong><t t-out="object.du_an_id.name or ''"/></strong> sắp đến hạn.</p>
                    
                    <p>📅 Ngày hết hạn: <strong><t t-out="object.ngay_kt or ''"/></strong></p>
                    
                    <p>Vui lòng cập nhật tiến độ để hoàn thành đúng hạn.</p>
                    
                    <p>Trân trọng,<br/>
                    Hệ thống quản lý công việc</p>
                </div>
            </field>
        </record>
    </data>
</odoo>