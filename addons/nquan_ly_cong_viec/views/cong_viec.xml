<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_cong_viec_form" model="ir.ui.view">
            <field name="name">cong_viec.form</field>
            <field name="model">cong_viec</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_read_only" style="font-size:25px">Công việc</div>
                        <field name="available_nhan_vien_ids" invisible="1"/>
                        <group string="Thông tin chung" col="4">
                            <field name="ma_cv" />
                            <field name="ten_cv" />
                            <field name="du_an_id" />
                            <field name="nhan_vien_phu_trach_ids" widget="many2many_tags" />
                            <field name="trang_thai" />
                        </group>
                        <group string="Thời gian" col="4">
                            <field name="ngay_bd" />
                            <field name="ngay_kt" />
                        </group>
                        <group string="Mô tả">
                            <field name="mo_ta" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_cong_viec_tree" model="ir.ui.view">
            <field name="name">cong_viec.tree</field>
            <field name="model">cong_viec</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ma_cv" />
                    <field name="ten_cv" />
                    <field name="du_an_id" />
                    <field name="nhan_vien_phu_trach_ids" widget="many2many_tags" />
                    <field name="trang_thai" />
                    <field name="ngay_bd" />
                    <field name="ngay_kt" />
                    <field name="tien_do_hien_tai" widget="progressbar"/>
                </tree>
            </field>
        </record>

        <record id="cong_viec_search" model="ir.ui.view">
            <field name="model">cong_viec</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ma_cv" />
                    <field name="ten_cv" />
                    <field name="du_an_id" />
                    <field name="nhan_vien_phu_trach_ids" widget="many2many_tags" />
                    <field name="trang_thai" />
                    <field name="ngay_bd" />
                    <field name="ngay_kt" />
                    <filter string="Việc của tôi" name="my_tasks" domain="[('nhan_vien_phu_trach_ids.user_id', '=', uid)]"/>
                </search>
            </field>
        </record>

        <record id="view_cong_viec_kanban" model="ir.ui.view">
            <field name="name">cong_viec.kanban</field>
            <field name="model">cong_viec</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="ma_cv" />
                    <field name="ten_cv" />
                    <field name="trang_thai" />
                    <field name="tien_do_hien_tai" />
                    <field name="du_an_id" />
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="ma_cv" /> - <field name="ten_cv" />
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>Dự án: <field name="du_an_id" /></div>
                                    <div>Trạng thái: <field name="trang_thai" /></div>
                                    <div>Tiến độ: <field name="tien_do_hien_tai" widget="progressbar"/></div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_cong_viec" model="ir.actions.act_window">
            <field name="name">Công việc</field>
            <field name="res_model">cong_viec</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="cong_viec_search" />
        </record>
    </data>
</odoo>