<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_tuong_tac_form" model="ir.ui.view">
            <field name="name">tuong_tac.form</field>
            <field name="model">tuong_tac</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_read_only" style="font-size:25px">Tương tác</div>
                        <group col="4">
                            <field name="khach_hang_id"/>
                            <field name="nhan_vien_id"/>
                            <field name="ngay"/>
                            <field name="kenh"/>
                        </group>
                        <group>
                            <field name="noi_dung"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_tuong_tac_tree" model="ir.ui.view">
            <field name="name">tuong_tac.tree</field>
            <field name="model">tuong_tac</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="khach_hang_id"/>
                    <field name="nhan_vien_id"/>
                    <field name="ngay"/>
                    <field name="kenh"/>
                </tree>
            </field>
        </record>

        <record id="tuong_tac_search" model="ir.ui.view">
            <field name="model">tuong_tac</field>
            <field name="arch" type="xml">
                <search>
                    <field name="khach_hang_id"/>
                    <field name="nhan_vien_id"/>
                    <field name="ngay"/>
                    <field name="kenh"/>
                </search>
            </field>
        </record>

        <record id="action_tuong_tac" model="ir.actions.act_window">
            <field name="name">Tương tác</field>
            <field name="res_model">tuong_tac</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="tuong_tac_search"/>
        </record>
    </data>
</odoo>

